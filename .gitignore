node_modules/
.env

# Build output. vercel.json runs `npm run build` with outputDirectory `public`,
# and scripts/build.mjs creates the directory itself, so nothing depends on a
# committed copy — and a committed copy can only ever be stale. It was: the
# snapshot was deleted from source and the deployed site went clean, while the
# file tracked here still carried every staff name into a public repository.
public/

# The tool that turns a local commit into an anchored patch for the GitHub web
# editor. It is scaffolding for how this repo gets pushed, not part of the app,
# and it reads the working tree — committing it would be committing the crane.
scripts/make-patch.mjs
