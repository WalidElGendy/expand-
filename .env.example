# Injected into the bundle by scripts/build.mjs. Set the same two values in
# Vercel -> Project -> Settings -> Environment Variables.
#
# The anon key is PUBLIC. It identifies the project; row-level security in the
# database decides what a signed-in user may read or write. The service_role
# key is the one that bypasses RLS — it must never be set here, and the build
# refuses to run if it finds one in the bundle.
SUPABASE_URL=https://ookiupgocavjbxcxquwl.supabase.co
SUPABASE_ANON_KEY=
